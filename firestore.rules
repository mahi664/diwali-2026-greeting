rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL'
        && request.auth.token.email_verified == true;
    }
    match /personalisationEvents/{eventId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['senderType','senderName','consent','createdAt','shareMethod'])
        && request.resource.data.consent == true
        && request.resource.data.senderType in ['individual','family','team','generic']
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 60
        && (request.resource.data.senderType == 'generic' || request.resource.data.senderName.size() > 0)
        && request.resource.data.createdAt == request.time
        && request.resource.data.shareMethod in ['whatsapp','copy'];
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
